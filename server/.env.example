# ── ParkX Server Environment Template ─────────────
PORT=5001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=parkx_app
DB_PASSWORD=replace-with-local-db-password
DB_NAME=parkx_db
# Production migrations use a separate schema owner account.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to the number of trusted reverse-proxy hops in production (for example 1).
TRUST_PROXY_HOPS=0
# COOKIE_SAME_SITE=strict
